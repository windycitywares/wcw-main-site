9:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$2","c",{"children":[[["$","section",null,{"className":"-i9KWa_intro","children":["$","div",null,{"className":"wrap","children":[["$","h1",null,{"className":"-i9KWa_title","children":"About WindyCityWares"}],["$","p",null,{"className":"-i9KWa_lead","children":"We make cremation urns and keepsakes that look like the life they hold, so the place where you keep a loved one feels like them."}]]}]}],["$","div",null,{"className":"wrap -i9KWa_body","children":[["$","section",null,{"className":"-i9KWa_split","aria-labelledby":"mission-title","children":[["$","h2",null,{"id":"mission-title","className":"h2","children":"Our mission"}],["$","div",null,{"className":"prose-wcw","children":[["$","p",null,{"children":"Choosing an urn usually happens in the hardest week of a family’s life. We want that choice to be simple and the result to be something you are glad to see every day: a lighthouse for someone who loved the coast, a ball field for a lifelong fan, a sky full of stars for someone who looked up."}],["$","p",null,{"children":"Each design is printed on the urn itself and paired with matching keepsakes, so brothers, sisters and children can each keep a part of the person they miss."}]]}]]}],["$","section",null,{"className":"-i9KWa_split","aria-labelledby":"story-title","children":[["$","h2",null,{"id":"story-title","className":"h2","children":"Our story"}],["$","div",null,{"className":"prose-wcw","children":[["$","p",null,{"children":"WindyCityWares began as a shop on Etsy, WindyCityWaresUS. As the number of designs grew past a hundred, we opened our own store at shop.windycitywares.com, where every design is organized into collections and easier to compare."}],["$","p",null,{"children":["The name comes from home. We work from ","Schaumburg, Illinois",", a short drive from downtown Chicago, the Windy City."]}]]}]]}],["$","div",null,{"className":"-i9KWa_photos","aria-hidden":"true","children":[["$","div","171",{"className